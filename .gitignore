__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
build/
dist/

# Benchmark harness
.venv/
# Regenerable via `python -m bench.emotions`; ~20 MB each. The derived vectors
# and the passage list ARE committed — those are the artifact.
# the emotion corpus is ~20 MB and fully regenerable by `python -m bench.emotions`,
# so it is rebuilt rather than shipped
results/**/emotion_activations*.npz
results/**/emotion_vectors*.npz
results/**/emotion_passages.json
results/emotion_activations*.npz

# Write-up prose, kept out of the repo deliberately — these are drafts for an external
# write-up, not artifacts of a run. The generated per-test .md files under results/ stay.
results/STORY.md
results/FINDINGS.md
results/novelty_audit.md
results/INDEX.md
# hand-written synthesis of prompt_elicitation.md + prompted_readout.md, and it
# cited the excluded FINDINGS.md. No script produces it.
results/queryability.md
results/t7_queryability/queryability.md
results/archive/README.md
AUDIT.md
# Write-up prose, at the repository ROOT only. Anchored with a leading slash: unanchored,
# these patterns match at any depth and silently swallowed same-named files in subdirectories
# -- files that were written, reported as committed, and were not.
/introduction.md
/references*.md
/figures/
/related_work.md
/methods.md
/results.md
/conclusion.md
/tables.md

# Recaptured all-layer activations: 582 MB across four files, each over GitHub's 100 MB
# hard limit. Regenerable with `python -m bench.run_probe_cis --model qwen`, same reasoning
# as the emotion activations above -- the derived JSON in results/ is the artifact.
results/activations/

# Reproduction output. reproduce.sh writes here and compare_repro.py diffs it against the
# committed results/, so it is scratch rather than an artifact.
results_repro*/

# Agent settings. Currently caught only by a machine-local global ignore, which does not
# travel with the repo -- this file records absolute paths under the developer's home
# directory, so it is ignored here too.
.claude/
